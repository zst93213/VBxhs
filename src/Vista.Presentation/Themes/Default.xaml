<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 默认浅色主题。与 HighContrast 共用同一组笔刷键名，便于运行时切换。 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FF1D1D1F"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF6E6E73"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD2D2D7"/>
    <SolidColorBrush x:Key="BrandBrush" Color="#FFE6162D"/>
    <SolidColorBrush x:Key="BrandTextBrush" Color="#FF9A0A1A"/>

    <Style x:Key="VisibleFocusVisualStyle" TargetType="Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Rectangle Margin="-2" StrokeThickness="2" Stroke="{StaticResource BrandBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <sys:Double x:Key="GlobalFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>

    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="AccessText">
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource VisibleFocusVisualStyle}"/>
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
</ResourceDictionary>
