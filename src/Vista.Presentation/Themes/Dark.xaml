<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题。与其它主题共用同一组笔刷键名。 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFAEAEB2"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF48484A"/>
    <SolidColorBrush x:Key="BrandBrush" Color="#FFFF453A"/>
    <SolidColorBrush x:Key="BrandTextBrush" Color="#FFFF9F0A"/>

    <Style x:Key="VisibleFocusVisualStyle" TargetType="Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Rectangle Margin="-2" StrokeThickness="2" Stroke="{StaticResource BrandBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <sys:Double x:Key="GlobalFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>

    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="AccessText">
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource VisibleFocusVisualStyle}"/>
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSize}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
</ResourceDictionary>
