<Window x:Class="Vista.Presentation.Dialogs.AccountManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号管理" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        AutomationProperties.Name="账号管理窗口"
        AutomationProperties.HelpText="查看已登录的所有账号，可删除账号。">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="已登录账号" FontWeight="Bold" FontSize="18"
                   AutomationProperties.Name="已登录账号列表标题"/>

        <ListBox x:Name="AccountListBox" Grid.Row="1" Margin="0,12,0,8"
                 AutomationProperties.Name="账号列表"
                 AutomationProperties.HelpText="按上下方向键选择账号，点击删除按钮移除账号。">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,6">
                        <TextBlock FontWeight="Bold" Text="{Binding DisplayName}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13">
                            <Run Text="平台："/><Run Text="{Binding PlatformName}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="删除选中账号" Padding="12,4" Margin="0,0,8,0"
                    AutomationProperties.Name="删除当前选中的账号及其凭证"
                    Click="OnDelete"/>
            <Button Content="关闭" Padding="12,4"
                    AutomationProperties.Name="关闭账号管理窗口"
                    Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
