<Window x:Class="Vista.Presentation.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        AutomationProperties.Name="设置窗口"
        AutomationProperties.HelpText="调整主题、字体大小和朗读方式。">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <TextBlock Text="设置" FontWeight="Bold" FontSize="20" Margin="0,0,0,16"
                       AutomationProperties.Name="设置标题"/>

            <!-- 主题 -->
            <GroupBox Header="主题" Margin="0,0,0,12"
                      AutomationProperties.Name="主题设置">
                <StackPanel Margin="8">
                    <RadioButton x:Name="ThemeNormal" Content="浅色（默认）" IsChecked="True"
                                 AutomationProperties.Name="浅色主题" GroupName="Theme"/>
                    <RadioButton x:Name="ThemeDark" Content="深色" Margin="0,4,0,0"
                                 AutomationProperties.Name="深色主题" GroupName="Theme"/>
                    <RadioButton x:Name="ThemeHighContrast" Content="高对比度" Margin="0,4,0,0"
                                 AutomationProperties.Name="高对比度主题，适合视力障碍用户" GroupName="Theme"/>
                </StackPanel>
            </GroupBox>

            <!-- 字体大小 -->
            <GroupBox Header="字体大小" Margin="0,0,0,12"
                      AutomationProperties.Name="字体大小设置">
                <StackPanel Margin="8">
                    <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="24" Value="14"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="字体大小滑块"
                            AutomationProperties.HelpText="拖动调整界面字体大小。"
                            ValueChanged="OnFontSizeChanged"/>
                    <TextBlock x:Name="FontSizePreview" Text="预览文字：当前字体大小 14"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 朗读 -->
            <GroupBox Header="朗读方式" Margin="0,0,0,12"
                      AutomationProperties.Name="朗读方式设置">
                <StackPanel Margin="8">
                    <CheckBox x:Name="AutoNarrate" Content="自动朗读操作结果（状态栏变化时）"
                              AutomationProperties.Name="自动朗读开关"
                              AutomationProperties.HelpText="开启后操作结果会自动通过屏幕阅读器播报。"/>
                    <CheckBox x:Name="UseSystemSpeech" Content="使用系统语音合成（TTS）" IsChecked="True"
                              Margin="0,4,0,0"
                              AutomationProperties.Name="使用系统语音合成"
                              AutomationProperties.HelpText="开启后手动朗读使用 Windows 语音合成。"/>
                </StackPanel>
            </GroupBox>

            <!-- 关于 -->
            <GroupBox Header="关于" Margin="0,0,0,12"
                      AutomationProperties.Name="关于本软件">
                <StackPanel Margin="8">
                    <TextBlock Text="Vista — 无障碍版微博客户端" FontWeight="Bold"/>
                    <TextBlock Text="基于 .NET Framework 4.8.1 + WPF" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="仅供个人和朋友使用，请勿用于商业用途。" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="所有请求通过 m.weibo.cn 移动端接口，带限流与加密 Cookie 存储。" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="应用" Padding="16,4" Margin="0,0,8,0"
                        AutomationProperties.Name="应用设置并关闭窗口"
                        Click="OnApply"/>
                <Button Content="取消" Padding="16,4"
                        AutomationProperties.Name="取消设置"
                        Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
