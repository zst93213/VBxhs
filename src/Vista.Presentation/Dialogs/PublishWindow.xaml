<Window x:Class="Vista.Presentation.Dialogs.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发布微博" Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        AutomationProperties.Name="发布微博窗口"
        AutomationProperties.HelpText="输入微博内容，可添加图片，然后发送。">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="发布新微博" FontWeight="Bold" FontSize="18"
                   AutomationProperties.Name="发布微博标题"/>

        <TextBox x:Name="ContentBox" Grid.Row="1" Margin="0,12,0,8"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="微博内容输入框"
                 AutomationProperties.HelpText="输入要发布的微博文字内容，支持多行。"
                 TextChanged="OnContentChanged"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="添加图片" Padding="10,2" Margin="0,0,8,0"
                    AutomationProperties.Name="从本地选择图片添加到微博"
                    Click="OnAddImage"/>
            <TextBlock x:Name="ImageCountText" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"
                       AutomationProperties.Name="已添加图片数量"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="16,4" Margin="0,0,8,0"
                    AutomationProperties.Name="取消发布"
                    Click="OnCancel"/>
            <Button x:Name="PublishBtn" Content="发布" Padding="16,4"
                    AutomationProperties.Name="确认发布微博"
                    IsEnabled="False"
                    Click="OnPublish"/>
        </StackPanel>
    </Grid>
</Window>
