<Window x:Class="Vista.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Vista.Presentation.Accessibility"
        xmlns:core="clr-namespace:Vista.Core.Adapters.Models;assembly=Vista.Core"
        Title="Vista — 无障碍版微博客户端"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.Name="Vista 无障碍版微博客户端主窗口"
        AutomationProperties.HelpText="支持多账号浏览、转发、评论、发布、超话签到，全键盘和读屏软件均可操作。">
    <Window.Resources>
        <DataTemplate x:Key="PostCardTemplate" DataType="{x:Type core:PostCard}">
            <a11y:CardItem Post="{Binding}">
                <a11y:CardItem.Content>
                    <StackPanel Margin="0,6">
                        <TextBlock FontWeight="Bold" Text="{Binding AuthorName}"/>
                        <TextBlock Text="{Binding TextSummary}" TextWrapping="Wrap" MaxHeight="80"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                       Text="{Binding LikeCount, StringFormat=👍 {0}}"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="12,0,0,0"
                                       Text="{Binding CommentCount, StringFormat=💬 {0}}"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="12,0,0,0"
                                       Text="{Binding RepostCount, StringFormat=🔁 {0}}"/>
                        </StackPanel>
                    </StackPanel>
                </a11y:CardItem.Content>
            </a11y:CardItem>
        </DataTemplate>

        <DataTemplate x:Key="CommentTemplate" DataType="{x:Type core:Comment}">
            <a11y:CommentItem Comment="{Binding}">
                <a11y:CommentItem.Content>
                    <StackPanel Margin="0,4">
                        <TextBlock FontWeight="Bold" Text="{Binding AuthorName}"/>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   Text="{Binding LikeCount, StringFormat=❤ {0}}"/>
                    </StackPanel>
                </a11y:CommentItem.Content>
            </a11y:CommentItem>
        </DataTemplate>

        <DataTemplate x:Key="HotSearchTemplate" DataType="{x:Type core:HotSearchItem}">
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="28" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"
                           Text="{Binding Rank}"/>
                <TextBlock Text="{Binding Keyword}" TextWrapping="Wrap"/>
                <TextBlock Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                           Text="{Binding Heat}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="UserRelationTemplate" DataType="{x:Type core:UserProfile}">
            <StackPanel Margin="0,4">
                <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                           Text="{Binding Bio}" TextWrapping="Wrap"/>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="13">
                    <Run Text="粉丝 "/><Run Text="{Binding FollowerCount}"/>
                    <Run Text="，关注 "/><Run Text="{Binding FollowCount}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <DockPanel Grid.Row="0" LastChildFill="True" Background="{StaticResource SurfaceMutedBrush}">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="12,8">
                <AccessText>当前账号：</AccessText>
                <ComboBox x:Name="AccountChip" Width="220" Margin="8,0,12,0"
                          AutomationProperties.Name="当前账号选择"
                          AutomationProperties.HelpText="展开后按上下方向键选择已登录账号，回车切换。"
                          SelectionChanged="OnAccountChanged"/>
                <Button Content="添加账号" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="添加新账号，打开微博扫码登录窗口"
                        Click="OnAddAccount"/>
                <Button Content="管理账号" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="打开账号管理器：查看、删除已登录账号"
                        Click="OnManageAccounts"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,8">
                <Button Content="刷新" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="刷新信息流，按 F5 快捷键也可触发"
                        Click="OnRefresh"/>
                <Button Content="热门" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="加载热门微博推荐流"
                        Click="OnHotWeibo"/>
                <Button Content="热搜" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="查看微博热搜榜"
                        Click="OnHotSearch"/>
                <Button Content="发布" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="打开发布微博窗口"
                        Click="OnPublish"/>
                <Button Content="点赞" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="一键点赞当前卡片，快捷键 Alt L"
                        Click="OnLike"/>
                <Button Content="收藏" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="一键收藏当前卡片，快捷键 Alt B"
                        Click="OnFavorite"/>
                <Button Content="转发" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="一键转发当前微博，快捷键 Alt F"
                        Click="OnRepost"/>
                <Button Content="关注作者" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="关注当前卡片的作者"
                        Click="OnFollowAuthor"/>
                <Button Content="用户主页" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="查看当前卡片作者的主页"
                        Click="OnViewAuthor"/>
                <Button Content="超话" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="打开超话浏览与签到窗口"
                        Click="OnSuperTopic"/>
                <Button Content="加载评论" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="加载当前卡片的评论列表"
                        Click="OnLoadComments"/>
                <Button Content="保存离线" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="将当前信息流保存到本地缓存"
                        Click="OnSaveOffline"/>
                <Button Content="账号状态" Padding="10,2" Margin="0,0,6,0"
                        AutomationProperties.Name="检查当前账号是否被限流"
                        Click="OnCheckHealth"/>
                <Button Content="设置" Padding="10,2" Margin="0,0,0,0"
                        AutomationProperties.Name="打开设置：主题、字体、朗读方式"
                        Click="OnSettings"/>
            </StackPanel>

            <TextBox x:Name="SearchBox" Margin="18,6" VerticalContentAlignment="Center"
                     KeyDown="OnSearchBoxKeyDown"
                     AutomationProperties.Name="搜索框，输入关键词后回车在微博上搜索内容"
                     AutomationProperties.HelpText="回车执行搜索，在微博上搜索相关内容。"/>
        </DockPanel>

        <!-- 三栏主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：导航 -->
            <ListBox x:Name="NavList" Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}"
                     AutomationProperties.Name="主导航菜单"
                     AutomationProperties.HelpText="使用上下方向键选择功能区，回车进入"
                     SelectionChanged="OnNavChanged">
                <ListBoxItem Tag="Home" AutomationProperties.Name="首页，显示关注信息流"/>
                <ListBoxItem Tag="Hot" AutomationProperties.Name="热门微博"/>
                <ListBoxItem Tag="HotSearch" AutomationProperties.Name="热搜榜"/>
                <ListBoxItem Tag="Publish" AutomationProperties.Name="发布微博"/>
                <ListBoxItem Tag="Me" AutomationProperties.Name="我的主页"/>
                <ListBoxItem Tag="Settings" AutomationProperties.Name="设置"/>
            </ListBox>

            <!-- 中栏：内容区（根据视图切换） -->
            <Border Grid.Column="1" Padding="12">
                <Grid>
                    <ListView x:Name="CardList" Background="Transparent" BorderThickness="0"
                              ItemTemplate="{StaticResource PostCardTemplate}"
                              AutomationProperties.Name="信息流内容列表"
                              AutomationProperties.HelpText="按 J 键下一张，K 键上一张，Enter 打开详情，L 点赞。"
                              MouseDoubleClick="OnCardDoubleClick"/>
                    <ListView x:Name="HotSearchList" Background="Transparent" BorderThickness="0"
                              ItemTemplate="{StaticResource HotSearchTemplate}"
                              AutomationProperties.Name="热搜榜列表"
                              AutomationProperties.HelpText="按上下方向键选择热搜，回车搜索该关键词。"
                              Visibility="Collapsed"
                              MouseDoubleClick="OnHotSearchDoubleClick"/>
                </Grid>
            </Border>

            <!-- 右栏：评论区 + 评论输入 -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceMutedBrush}" Padding="12">
                <DockPanel LastChildFill="True">
                    <!-- 用户主页信息（查看用户时显示） -->
                    <StackPanel x:Name="UserProfilePanel" DockPanel.Dock="Top" Margin="0,0,0,8"
                                Visibility="Collapsed">
                        <TextBlock x:Name="UserNameText" FontWeight="Bold" FontSize="18"
                                   AutomationProperties.Name="用户昵称"/>
                        <TextBlock x:Name="UserBioText" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" AutomationProperties.Name="用户简介"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding CurrentUserProfile.PostCount, StringFormat=微博 {0}}"/>
                            <TextBlock Text="{Binding CurrentUserProfile.FollowCount, StringFormat=  关注 {0}}" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding CurrentUserProfile.FollowerCount, StringFormat=  粉丝 {0}}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="粉丝" Padding="8,2" Margin="0,0,6,0"
                                    AutomationProperties.Name="查看该用户的粉丝列表"
                                    Click="OnLoadFollowers"/>
                            <Button Content="关注" Padding="8,2" Margin="0,0,6,0"
                                    AutomationProperties.Name="查看该用户的关注列表"
                                    Click="OnLoadFollowing"/>
                            <Button Content="关注TA" Padding="8,2" Margin="0,0,6,0"
                                    AutomationProperties.Name="关注该用户"
                                    Click="OnFollowProfileUser"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 评论输入区 -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
                        <Button x:Name="SendCommentBtn" Content="发送" DockPanel.Dock="Right" Padding="12,4"
                                AutomationProperties.Name="发表评论，发送到当前微博"
                                Click="OnSendComment"/>
                        <TextBox x:Name="CommentInput" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                 KeyDown="OnCommentInputKeyDown"
                                 AutomationProperties.Name="评论输入框，输入评论内容后回车发送"
                                 AutomationProperties.HelpText="回车发送评论，评论会发布到当前选中的微博。"/>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="评论区" FontWeight="Bold"
                               AutomationProperties.Name="右栏评论区标题" Margin="0,0,0,8"/>
                    <ListView x:Name="CommentList" Background="Transparent" BorderThickness="0"
                              ItemTemplate="{StaticResource CommentTemplate}"
                              AutomationProperties.Name="当前卡片的评论列表"
                              AutomationProperties.HelpText="按上下方向键切换评论。"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2" Background="{StaticResource SurfaceMutedBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"
                          AutomationProperties.LiveSetting="Polite"
                          AutomationProperties.Name="状态栏，显示当前操作结果和系统状态"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
