<Window x:Class="Vista.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista — 无障碍版微博 & 小红书聚合客户端"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <!-- AutomationProperties.Name 让读屏在窗口打开时朗读完整标题 -->
    <Window.AutomationProperties>
        <AutomationProperties>Name>Vista 主窗口</AutomationProperties>
        <AutomationProperties.HelpText>无障碍版微博与小红书聚合客户端。按 Alt 加数字键切换功能区。</AutomationProperties.HelpText>
    </Window.AutomationProperties>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 顶部栏 -->
            <RowDefinition Height="*"/>      <!-- 三栏主体 -->
            <RowDefinition Height="Auto"/>   <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部栏：账号 Chip 区 + 搜索 + 朗读 + 设置 -->
        <DockPanel Grid.Row="0" LastChildFill="True" Background="{StaticResource SurfaceMutedBrush}">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="12,8">
                <AccessText>账号：</AccessText>
                <ComboBox x:Name="AccountChip" Width="220" Margin="8,0,24,0"
                          AutomationProperties.Name="当前账号选择"
                          AutomationProperties.HelpText="Ctrl 加数字键可快速切换账号"/>
                <Button Content="管理账号" Padding="8,2" Margin="0,0,8,0"
                        AutomationProperties.Name="打开账号管理器"
                        Click="OnManageAccounts"/>
                <Button Content="添加账号" Padding="8,2"
                        AutomationProperties.Name="添加新账号（微博或小红书）"
                        Click="OnAddAccount"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="朗读当前卡片" Padding="10,2" Margin="8,0"
                    AutomationProperties.Name="朗读当前卡片全文（Alt Shift R）"
                    Click="OnNarrateCurrent"/>
            <Button DockPanel.Dock="Right" Content="设置" Padding="10,2" Margin="0,0,8,0"
                    AutomationProperties.Name="打开设置"/>
            <TextBox x:Name="SearchBox" Margin="12,6" VerticalContentAlignment="Center"
                     AutomationProperties.Name="搜索框"
                     AutomationProperties.HelpText="输入关键词后回车搜索"/>
        </DockPanel>

        <!-- 三栏主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：导航。Alt+1..5 切换 -->
            <ListBox x:Name="NavList" Grid.Column="0" Background="{StaticResource SurfaceMutedBrush}"
                     AutomationProperties.Name="主导航"
                     AutomationProperties.HelpText="Alt 加 1 到 5 切换功能区"
                     SelectionChanged="OnNavChanged">
                <ListBoxItem AutomationProperties.Name="1 首页" Tag="Home"/>
                <ListBoxItem AutomationProperties.Name="2 消息" Tag="Messages"/>
                <ListBoxItem AutomationProperties.Name="3 发布" Tag="Publish"/>
                <ListBoxItem AutomationProperties.Name="4 我的" Tag="Me"/>
                <ListBoxItem AutomationProperties.Name="5 设置" Tag="Settings"/>
            </ListBox>

            <!-- 中栏：信息流主区域（焦点主战场）。CardList 用自定义 Peer 分段朗读 -->
            <Border Grid.Column="1" Padding="12">
                <ListView x:Name="CardList"
                          Background="Transparent"
                          BorderThickness="0"
                          AutomationProperties.Name="信息流"
                          AutomationProperties.HelpText="J 下一张，K 上一张，Enter 打开，L 点赞，C 评论"/>
            </Border>

            <!-- 右栏：上下文面板（评论/消息/账号详情） -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceMutedBrush}" Padding="12">
                <ContentControl x:Name="ContextPanel"
                                AutomationProperties.Name="详情面板"/>
            </Border>
        </Grid>

        <!-- 底部状态栏。LiveRegion=Polite：状态变化时读屏轻量朗读 -->
        <StatusBar Grid.Row="2" Background="{StaticResource SurfaceMutedBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"
                          AutomationProperties.LiveSetting="Polite"
                          AutomationProperties.Name="状态栏"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
