<Window x:Class="Vista.Presentation.Auth.WebView2LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微博扫码登录" Height="560" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        AutomationProperties.Name="微博扫码登录窗口"
        AutomationProperties.HelpText="用手机微博 App 扫描二维码登录，登录成功后凭证加密保存。">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <TextBlock Grid.Row="0" Text="微博扫码登录" FontSize="20" FontWeight="Bold"
                   Margin="0,16,0,8" HorizontalAlignment="Center"
                   AutomationProperties.Name="微博扫码登录标题"/>

        <!-- 二维码图片区 -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
            <Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform"
                   AutomationProperties.Name="微博登录二维码，请用手机微博扫描"
                   AutomationProperties.HelpText="打开手机微博，点击右上角扫一扫，对准此二维码完成登录"/>
        </Border>

        <!-- 底部状态 + 刷新按钮 -->
        <StackPanel Grid.Row="2" Margin="0,8,0,16">
            <TextBlock x:Name="LoginStatus" Text="正在生成二维码..."
                       HorizontalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="登录状态"/>
            <Button x:Name="RefreshQrBtn" Content="刷新二维码" Margin="0,8,0,0"
                    HorizontalAlignment="Center" Padding="20,6"
                    AutomationProperties.Name="刷新二维码，重新生成登录二维码"
                    Click="OnRefreshQr"/>
        </StackPanel>
    </Grid>
</Window>
