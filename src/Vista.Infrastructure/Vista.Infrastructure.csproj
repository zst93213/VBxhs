<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>false</UseWPF>
    <RootNamespace>Vista.Infrastructure</RootNamespace>
    <Description>HTTP 客户端、SQLite 缓存、Serilog 日志、配置中心</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- net48 框架程序集：HttpClient / HttpResponseMessage 在 System.Net.Http；
         ConcurrentDictionary/File 在 mscorlib 与 System；不需要额外引用 -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- Serilog 2.x 使用 ILogEventPropertyFactory API（与 SerilogBootstrap.cs 中的 SecretMaskingDestructurer 一致）；
         3.x 改为 ILogEventPropertyValueFactory，会破坏现有代码。 -->
    <PackageReference Include="Polly" Version="7.2.4" />
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="4.0.1" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.117" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vista.Core\Vista.Core.csproj" />
  </ItemGroup>
</Project>
