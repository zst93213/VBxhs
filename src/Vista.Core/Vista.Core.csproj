<?xml version="1.0" encoding="utf-8"?>
<!-- Vista.Core：核心抽象层。零业务依赖、零 HTTP，只定义跨平台统一接口与模型。
     设计参考 sinaweibopy 的 mixin 模式 + Xiaohongshu-API 的 Crawler/Interaction 二分。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseWPF>false</UseWPF>
    <RootNamespace>Vista.Core</RootNamespace>
    <Description>核心接口与统一模型（IPlatformAdapter / ICrawlerAdapter / IInteractionAdapter）</Description>
  </PropertyGroup>
</Project>
